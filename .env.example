MONGODB_URI=mongodb://dbUser:your_password@your_ip:your_port/?authMechanism=DEFAULT
# Optional: override the users/auth database name (defaults to "Users")
# MONGODB_AUTH_DB=Users
# MongoDB Transaction Support (Optional)
# Set to 'true' to enable transactions in Better Auth
# Only enable if using MongoDB replica set or Atlas (transactions not supported on standalone servers)
# Default: false (transactions disabled - safe for standalone MongoDB)
MONGODB_TRANSACTIONS=false
# Auth
BETTER_AUTH_URL=https://cinema.your-domain.com
BETTER_AUTH_SECRET=your_better_auth_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Discord Auth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# TMDB Server Configuration
# Note: The Next.js app does NOT use a direct TMDB_API_KEY. External media
# metadata is proxied through the Node server, which holds the TMDB key.
# Optional: Dedicated TMDB server URL (falls back to NODE_SERVER_URL if not set)
# TMDB_NODE_SERVER_URL=https://subdomain.your-domain.com/node/tmdb
#Chromecast
CHROMECAST_RECEIVER_ID=your_chromecast_receiver_id
#Deployment Specific
NEXT_PUBLIC_BASE_URL=https://cinema.your-domain.com
#
# Webhook IDs for server authentication - NOT prefixed with NEXT_PUBLIC_
# Each webhook ID corresponds to a specific server and is used for authentication
# The index in WEBHOOK_ID_X should match the index in NODE_SERVER_URL_X
WEBHOOK_ID=322fb39e4591514d2b8c1697sbc72c9c # Default/main server webhook ID
# WEBHOOK_ID_2=521ebe9e6211514d2b8c1697sbc72c98 # Second server webhook ID (if configured)
# WEBHOOK_ID_3=another_webhook_id_here # Third server webhook ID (if configured)
# Optional read-only token for desktop widgets and media activity dashboards.
# Existing WEBHOOK_ID values are also accepted for this API.
# MEDIA_ACTIVITY_API_KEY=your_media_activity_api_key
# 
# These webhook IDs are used for:
# 1. Authenticating system status notifications
# 2. Validating webhook requests for synchronization
# 3. Identifying which server a request is coming from
#
SONARR_ICAL_LINK=https://your-radarr-server.com/sonarr/feed/v3/calendar/Sonarr.ics?apikey=your_api_key&PastDays=1880&FutureDays=380
RADARR_ICAL_LINK=https://your-radarr-server.com/radarr/feed/v3/calendar/Radarr.ics?unmonitored=true&apikey=your_api_key&PastDays=1880&FutureDays=380
# File Server (Runtime Environment Variables - adapt to deployment server)
FILE_SERVER_URL=https://subdomain.your-domain.com
NODE_SERVER_URL=https://subdomain.your-domain.com/node # Depends on your node path

# Optional: Internal server URL for improved performance (server-to-server communication)
# Use internal IP/hostname when Next.js and Node server are on the same network
# Falls back to NODE_SERVER_URL when not configured
# NODE_SERVER_INTERNAL_URL=http://192.168.1.100:3000/node
# Optional for Reverse Proxy paths to FILE_SERVER_URL
# FILE_SERVER_PREFIX_PATH=/media
# Admin Users
# Comma Seperated Emails
ADMIN_USER_EMAILS=email1@xxxx.com,email2@zzzz.com
# Privacy Policy - Show admin emails in privacy policy (set to 'false' to hide)
SHOW_ADMIN_EMAILS=true
# Site Title
NEXT_PUBLIC_SITE_TITLE=Cinema Sanctuary
# Site Description
NEXT_PUBLIC_SITE_DESCRIPTION=Sharing media content with friends and family.
# Image remote hosts for next/image.
# NOTE: currently NOT consumed — next.config.js allows all remote hosts
# (remotePatterns hostname: '**'). Kept for reference; re-enable the
# REMOTE_PATTERNS logic in next.config.js if you want to restrict allowed hosts.
# REMOTE_PATTERNS=https://subdomain.your-domain.com,https://image.tmdb.org,https://m.media-amazon.com
# Optional for Reverse Proxy paths to FILE_SERVER_URL
#FILE_SERVER_PREFIX_PATH=/media

# ============================================================================
# imgproxy Offload (Optional)
# ============================================================================
# Offload next/image resizing/encoding to an imgproxy container instead of
# the built-in sharp optimizer — useful when the Next.js host is CPU
# constrained. Leave IMGPROXY_URL unset to keep the built-in optimizer.
# All values are read at runtime; no rebuild needed to enable or disable.
#
# IMGPROXY_URL=http://imgproxy:8080
#
# Request mode (default: proxy)
#  - proxy:    Next.js rewrites /_next/image to imgproxy and streams the
#              response back. imgproxy can stay internal to the docker
#              network (no public exposure needed).
#  - redirect: /_next/image answers with a 307 and the browser fetches from
#              imgproxy directly — zero image bytes flow through Next.js,
#              but IMGPROXY_URL must then be reachable by browsers.
# IMGPROXY_REQUEST_MODE=proxy
#
# URL signing (recommended) — hex-encoded pair that must match the
# IMGPROXY_KEY / IMGPROXY_SALT configured on the imgproxy container.
# Set both or neither; a half-configured or non-hex pair disables the
# offload (falls back to the built-in optimizer, error logged once).
# Generate each with: openssl rand -hex 32
# IMGPROXY_KEY=your_hex_key
# IMGPROXY_SALT=your_hex_salt
#
# Notes:
# - Only absolute remote image URLs (file servers, TMDB) are offloaded;
#   local /public assets keep using the built-in optimizer.
# - On the imgproxy container, set IMGPROXY_ENABLE_WEBP_DETECTION=true and
#   IMGPROXY_ENABLE_AVIF_DETECTION=true to keep modern-format negotiation,
#   and consider IMGPROXY_ALLOWED_SOURCES to restrict fetchable origins.
# ============================================================================

# ============================================================================
# OpenTelemetry Configuration (SigNoz Integration)
# ============================================================================
# Enable/disable OpenTelemetry tracing
OTEL_ENABLED=true

# Service name in SigNoz (will appear as your service in the dashboard)
OTEL_SERVICE_NAME=nextjs-stream

# OpenTelemetry Collector endpoint (base URL without /v1/traces)
# @vercel/otel with traceExporter: "auto" will automatically append the correct path
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Protocol for OTLP exporter (http/protobuf is recommended for performance)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Resource attributes for better trace grouping and identification in SigNoz
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=latest,service.namespace=nextjs-stream

# Propagators for distributed tracing across services
OTEL_PROPAGATORS=tracecontext,baggage

# Sampling configuration - Controls what percentage of traces are captured
# Option A: Sample everything (recommended for debugging/low-traffic environments)
OTEL_TRACES_SAMPLER=always_on

# Option B: Sample percentage (recommended for high-traffic production)
# Uncomment these lines and comment out OTEL_TRACES_SAMPLER=always_on above
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25

# Next.js OpenTelemetry verbose logging (0=off, 1=on - useful for debugging OTEL issues)
NEXT_OTEL_VERBOSE=0

# Structured Logging Configuration (Pino + OpenTelemetry)
# Controls the minimum log level for structured logs sent to SigNoz
# Levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Optional: OTLP Headers for authentication (if your SigNoz setup requires API keys)
# OTEL_EXPORTER_OTLP_HEADERS=api-key=your_signoz_api_key_here
# ============================================================================

# Cross-Domain Authentication (Optional)
# If your Next.js app and Node server are on different subdomains of the same parent domain,
# set this to enable cookie sharing across subdomains.
# Example: If using cinema.example.com and node.example.com, set to "example.com"
# Leave blank or unset for default single-domain behavior (most secure for single-domain deployments)
AUTH_COOKIE_DOMAIN=

# When to use AUTH_COOKIE_DOMAIN:
# - Set if Next.js app and Node server are on DIFFERENT subdomains (e.g., cinema.example.com and node.example.com)
# - Value should be the root domain WITHOUT a leading dot: "example.com" (not ".example.com")
# - Leave BLANK for single-domain deployments (more secure)
#
# Security Note:
# - Setting this shares cookies across ALL subdomains of the parent domain
# - Only use if you control all subdomains
# - For completely different domains, use webhook authentication instead
#
# Examples:
# AUTH_COOKIE_DOMAIN=example.com    # Shares cookies between app.example.com and api.example.com

# Multi-Server (Runtime Environment Variables)
# If you re-enable REMOTE_PATTERNS in next.config.js, add each file server host to it
# NODE_SERVER_URL_2=https://subdomain.your-second-domain.com/node
# FILE_SERVER_URL_2=https://subdomain.your-second-domain.com

# Optional: Internal server URLs for multi-server setups (improved performance)
# NODE_SERVER_INTERNAL_URL_2=http://192.168.1.101:3000/node

# Optional for Reverse Proxy paths to FILE_SERVER_URL_2
# FILE_SERVER_PREFIX_PATH_2=/media

# NODE_SERVER_URL_3=https://subdomain.your-third-domain.com/utils
# FILE_SERVER_URL_3=https://subdomain.your-third-domain.com

# Optional: Internal server URLs for multi-server setups (improved performance)
# NODE_SERVER_INTERNAL_URL_3=http://192.168.1.102:3000/utils

# Optional for Reverse Proxy paths to FILE_SERVER_URL_3
# FILE_SERVER_PREFIX_PATH_3=/public

# ============================================================================
# System Status - Admin Queue Monitoring (Optional)
# ============================================================================
# These variables enable the admin dashboard queue monitoring panels.
# All are optional — omit any service you don't use and its panel will be
# hidden automatically.

# SABnzbd download client
# SABNZBD_URL=http://your-sabnzbd-server:8080
# SABNZBD_API_KEY=your_sabnzbd_api_key

# Radarr movie management
# RADARR_URL=http://your-radarr-server:7878
# RADARR_API_KEY=your_radarr_api_key

# Sonarr TV show management
# SONARR_URL=http://your-sonarr-server:8989
# SONARR_API_KEY=your_sonarr_api_key

# Tdarr transcoding management
# TDARR_URL=http://your-tdarr-server:8265
# TDARR_API_KEY=your_tdarr_api_key

# Disk Health Monitoring
# Comma-separated list of mount paths that should trigger health alerts in the
# admin server-load panel. When unset, all non-system /dev/* mounts are used.
# System mounts (/, /boot, /run, /tmp, /var/lib/docker) are always excluded.
# Set this to focus alerts on specific drives (e.g. your media storage volume).
# DISK_HEALTH_PATHS=/mnt/media,/mnt/ssd_media

# Server Load Panel — per-metric enable/disable flags (default: all enabled)
# Set any of these to 'false' to hide that metric from the admin dashboard.
# SERVER_LOAD_CPU_ENABLED=true
# SERVER_LOAD_MEMORY_ENABLED=true
# SERVER_LOAD_DISK_ENABLED=true

# Server Load Panel — alert thresholds (0–100, integers)
# Global defaults: all metrics use these values unless a per-metric override is set.
# SERVER_LOAD_WARN_THRESHOLD=50
# SERVER_LOAD_CRITICAL_THRESHOLD=80
#
# Per-metric overrides — fall back to the global values above when not set.
# Useful when different metrics have different "normal" ranges, e.g. disk
# storage volumes routinely sit at 80%+ long before they're a real problem.
# SERVER_LOAD_CPU_WARN_THRESHOLD=50
# SERVER_LOAD_CPU_CRITICAL_THRESHOLD=80
# SERVER_LOAD_MEMORY_WARN_THRESHOLD=75
# SERVER_LOAD_MEMORY_CRITICAL_THRESHOLD=90
# SERVER_LOAD_DISK_WARN_THRESHOLD=80
# SERVER_LOAD_DISK_CRITICAL_THRESHOLD=99
# ============================================================================

# User Approval Settings
# Set to 'true' to automatically approve new users, 'false' to require manual admin approval (default)
AUTO_APPROVE_USERS=false

# Sync Architecture Settings
# NOTE: this variable currently has no effect. shouldUseNewArchitecture() in
# src/utils/sync/featureFlags.js returns true in every branch, so the
# domain-driven architecture is always used regardless of what is set here.
# Legacy flat sync is reached only through the runtime forceOld option or the
# automatic fallback in flatSync/index.js.
USE_NEW_SYNC_ARCHITECTURE=false
