{
  "version": "0.2.0",
  "configurations": [
    {
      // Breakpoints in src/ for API route handlers, proxy.ts, instrumentation
      // and the utils/lib code they run. NOT for pages, layouts or server
      // components: use "no source maps" below, or Chrome DevTools via
      // chrome://inspect (the preLaunchTask's server already has --inspect).
      //
      // Why the split. The debugger runs inside the VS Code extension host and
      // has taken it down three ways (2026-10-07):
      // 1. A *launched* session hands NODE_OPTIONS to every child, and `next
      //    dev` starts ~26 Turbopack loader/PostCSS workers, so it attached to
      //    all of them. Hence attach-only: the preLaunchTask runs `next dev
      //    --inspect`, Next puts the inspector on its server process (9229), and
      //    the workers' attempts fail harmlessly ("address already in use").
      // 2. In dev, React's Flight client evals a small stub script per server
      //    component stack frame, each pointing at its whole chunk's source map,
      //    and js-debug re-parses that map for every stub (its cache is keyed by
      //    script hash). Ten page loads = ~1,900 stubs = ~1.5 GB of map parsing,
      //    all against maps in .next/dev/server/chunks/ssr/, where pages and
      //    server components live. Route handlers, proxy and instrumentation
      //    live one level up in chunks/ (~12 MB for the same ten loads).
      // 3. One glob on purpose: js-debug recompiles every pattern for each
      //    source of each map it loads. `*` stops at the ssr/ folder, and
      //    library-only chunks are named after their node_modules path.
      "name": "Next.js: debug server (API routes, proxy)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "next dev --inspect",
      "resolveSourceMapLocations": ["${workspaceFolder}/.next/dev/server/chunks/!(*node_modules*)"],
      "outFiles": [
        "${workspaceFolder}/.next/dev/server/chunks/*.js",
        "!${workspaceFolder}/.next/**/*node_modules*"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "${workspaceFolder}/.next/**/*node_modules*"
      ]
    },
    {
      // Anything on the server, pages and server components included, without
      // source maps: breakpoints and `debugger;` statements land in the
      // compiled chunks under .next/dev/server, which Turbopack leaves readable
      // in dev. Safe at any page count.
      "name": "Next.js: debug server (no source maps)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "next dev --inspect",
      "sourceMaps": false,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "${workspaceFolder}/.next/**/*node_modules*"
      ]
    },
    {
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3232",
      "skipFiles": ["**/node_modules/**"]
    },
    {
      "name": "Next.js: debug client-side (Firefox)",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:3232",
      "reAttach": true,
      "pathMappings": [
        {
          "url": "webpack://_N_E",
          "path": "${workspaceFolder}"
        }
      ]
    }
  ],
  "compounds": [
    {
      // Server attach + browser. The task finishes starting the server before
      // either session begins, so the browser never opens on a dead port.
      "name": "Next.js: debug full stack",
      "configurations": ["Next.js: debug server (API routes, proxy)", "Next.js: debug client-side"],
      "preLaunchTask": "next dev --inspect",
      "stopAll": true
    }
  ]
}
